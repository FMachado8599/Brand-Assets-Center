NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aca

# Conversor: API key de https://www.freeconvert.com/api (solo servidor, sin NEXT_PUBLIC_)
FREECONVERT_API_KEY=

# Emojis: búsqueda por significado (embeddings de OpenAI). Opcional: sin esto se busca por palabras.
OPENAI_API_KEY=

# Emojis: bucket de Firebase Storage con los PNG (opcional, este es el valor por defecto)
# EMOJI_STORAGE_BUCKET=camara-focus.firebasestorage.app

# Inicio → Sugerencias: los mails se mandan con Resend (https://resend.com). Solo servidor.
# Sin dominio verificado en Resend, crear la cuenta de Resend con el mismo mail que recibe.
RESEND_API_KEY=
# FEEDBACK_TO=fmachado@camaratbwa.com
# FEEDBACK_FROM=Herramientas <sugerencias@tu-dominio-verificado.com>

# Spotify (el Jam en /spotify): app de developer.spotify.com/dashboard. Solo servidor, sin NEXT_PUBLIC_.
# INTEGRACIONES_SECRET (32+ caracteres) cifra la conexión del DJ.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
INTEGRACIONES_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Basecamp (Board): app de launchpad.37signals.com/integrations. Solo servidor, sin NEXT_PUBLIC_.
# Usa el mismo INTEGRACIONES_SECRET de arriba para cifrar los tokens.
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
# Tiene que ser EXACTO el Redirect URI registrado en 37signals (por defecto, el origen + esta ruta).
# BASECAMP_REDIRECT_URI=https://tu-app.vercel.app/api/auth/callback/basecamp
# Si la persona que conecta tiene más de una cuenta de Basecamp, cuál usar (el número de la URL).
# BASECAMP_ACCOUNT_ID=
# Basecamp exige identificarse: "Nombre de la app (mail de contacto)".
# BASECAMP_USER_AGENT=Herramientas Camara TBWA (fmachado@camaratbwa.com)
# Los avisos al instante (webhooks) necesitan la dirección pública https de la app. En Vercel sale
# sola del dominio de producción; en local y en los previews no se registran a propósito.
# APP_URL=https://tu-app.vercel.app
